{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Run log row",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "timestamp": { "type": "string" },
    "trial":     { "type": "integer", "minimum": 0 },
    "outcome":   { "type": "string", "enum": ["CLEAN", "WRONG", "CRASH", "DEGRADED"] },
    "seed":      { "type": "integer" },
    "device":    { "type": "string" },
    "model":     { "type": "string" },
    "dataset":   { "type": "string" },
    "layer_id":  { "type": "string" },

    "p":         { "type": "number" },
    "bit_mode":  { "type": "integer" },

    "avg_latency_ms_per_sample": { "type": "number" },

    "changed":      { "type": ["integer", "null"] },
    "changed_rate": { "type": ["number", "null"] },

    "clean_margin_avg": { "type": ["number", "null"] },
    "inj_margin_avg":   { "type": ["number", "null"] },
    "margin_drop_avg":  { "type": ["number", "null"] },

    "bitpos":      { "type": ["integer", "null"] },
    "flat_index":  { "type": ["integer", "null"] },
    "k":           { "type": ["integer", "null"] },
    "indices_count": { "type": ["integer", "null"] },
    "injected":    { "type": ["boolean", "null"] },

    "plan":    { "type": "string" },
    "shard":   { "type": "integer" },
    "shards":  { "type": "integer" }
  },
  "required": [
    "timestamp", "trial", "outcome",
    "device", "model", "dataset", "layer_id",
    "p", "bit_mode",
    "plan", "shard", "shards"
  ]
}
